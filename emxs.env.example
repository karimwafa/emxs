# EMXS Email Exchanger Studio Environment Configuration
# File: /etc/emxs/emxs.env

# Server Identity
EMXS_SERVER_HOST=mail.example.com
EMXS_PRIMARY_DOMAIN=example.com
EMXS_SERVER_IP=1.2.3.4

# Database Connection (PostgreSQL)
EMXS_DB_CONN=host=localhost port=5432 user=mailuser password=YOUR_DB_PASSWORD dbname=mailserver sslmode=disable

# Web & API Ports
PORT=8080

# SSL / TLS Certificates
EMXS_SSL_CERT=/etc/letsencrypt/live/mail.example.com/fullchain.pem
EMXS_SSL_KEY=/etc/letsencrypt/live/mail.example.com/privkey.pem

# Initial Superadmin Credentials (used during first startup if users table is empty)
EMXS_ADMIN_USER=admin
EMXS_ADMIN_EMAIL=admin@example.com
EMXS_ADMIN_PASS=Admin_EMXS2026!Sec
